  <property name="styleSheet">
   <string notr="true">
QMainWindow {
    background-color: #F5F0FF;
}

QGroupBox {
    background-color: #FFFFFF;
    border: 2px solid #E8DCFF;
    border-radius: 12px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: 600;
    font-size: 13px;
    color: #6B4BA0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 15px;
    padding: 2px 8px;
    background-color: #DFD3F5;
    border-radius: 6px;
    color: #5A3D8A;
}

QPushButton {
    background-color: #D4C5F9;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
    color: #5A3D8A;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #C4B0F0;
}

QPushButton:pressed {
    background-color: #B49FE8;
}

QPushButton:disabled {
    background-color: #E8E8E8;
    color: #A0A0A0;
}

QPushButton#startButton {
    background-color: #B8E6D5;
    color: #2D6A4F;
}

QPushButton#startButton:hover {
    background-color: #A0DCCA;
}

QPushButton#pauseResumeButton {
    background-color: #FFE5B4;
    color: #8B6914;
}

QPushButton#pauseResumeButton:hover {
    background-color: #FFD89B;
}

QPushButton#stopButton {
    background-color: #FFB8C6;
    color: #8B2E3D;
}

QPushButton#stopButton:hover {
    background-color: #FFA0B3;
}

QPushButton#loadPreviousButton {
    background-color: #C8E0F9;
    color: #2E5A8B;
}

QPushButton#loadPreviousButton:hover {
    background-color: #B0D4F5;
}

QPushButton#sortButton {
    background-color: #FFD4E5;
    color: #8B2E5A;
}

QPushButton#sortButton:hover {
    background-color: #FFBDD8;
}

QPushButton#addFilterButton {
    background-color: #D4F9E6;
    color: #2D6A4F;
}

QPushButton#addFilterButton:hover {
    background-color: #BCEFD9;
}

QPushButton#applyFilterButton {
    background-color: #D4F9E6;
    color: #2D6A4F;
}

QPushButton#applyFilterButton:hover {
    background-color: #BCEFD9;
}

QPushButton#clearFilterButton {
    background-color: #FFE0CC;
    color: #8B4513;
}

QPushButton#clearFilterButton:hover {
    background-color: #FFD0B3;
}

QProgressBar {
    border: 2px solid #E8DCFF;
    border-radius: 8px;
    background-color: #F9F5FF;
    text-align: center;
    font-weight: 600;
    color: #6B4BA0;
    height: 24px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                      stop:0 #D4C5F9, stop:1 #B8A8E8);
    border-radius: 6px;
    margin: 2px;
}

QLabel {
    color: #5A3D8A;
    font-weight: 500;
    font-size: 12px;
}

QLabel#sortTimeLabel {
    background-color: #FFF9E6;
    border: 2px solid #FFE5B4;
    border-radius: 6px;
    padding: 4px 8px;
    color: #8B6914;
}

QComboBox {
    background-color: #FFFFFF;
    border: 2px solid #E8DCFF;
    border-radius: 6px;
    padding: 6px 10px;
    color: #5A3D8A;
    font-weight: 500;
}

QComboBox:hover {
    border: 2px solid #D4C5F9;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #8B6FB8;
    width: 0;
    height: 0;
    margin-right: 8px;
}

QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #E8DCFF;
    border-radius: 6px;
    padding: 6px 10px;
    color: #5A3D8A;
    font-weight: 500;
}

QLineEdit:focus {
    border: 2px solid #C4B0F0;
}

QRadioButton {
    color: #5A3D8A;
    font-weight: 500;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #D4C5F9;
    background-color: #FFFFFF;
}

QRadioButton::indicator:checked {
    background-color: #B8A8E8;
    border: 2px solid #8B6FB8;
}

QRadioButton::indicator:hover {
    border: 2px solid #B8A8E8;
}

QListWidget {
    background-color: #FFFFFF;
    border: 2px solid #E8DCFF;
    border-radius: 8px;
    padding: 4px;
    color: #5A3D8A;
}

QListWidget::item {
    border-radius: 4px;
    padding: 4px 8px;
    margin: 2px;
}

QListWidget::item:selected {
    background-color: #DFD3F5;
    color: #5A3D8A;
}

QListWidget::item:hover {
    background-color: #F0E8FF;
}

QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F9F5FF;
    border: 2px solid #E8DCFF;
    border-radius: 8px;
    gridline-color: #F0E8FF;
    color: #5A3D8A;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #DFD3F5;
    color: #5A3D8A;
}

QHeaderView::section {
    background-color: #DFD3F5;
    color: #5A3D8A;
    padding: 8px;
    border: none;
    border-right: 1px solid #CFBFF0;
    border-bottom: 2px solid #CFBFF0;
    font-weight: 600;
}

QHeaderView::section:first {
    border-top-left-radius: 6px;
}

QHeaderView::section:last {
    border-top-right-radius: 6px;
    border-right: none;
}

QScrollBar:vertical {
    background-color: #F9F5FF;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #D4C5F9;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #C4B0F0;
}

QScrollBar:horizontal {
    background-color: #F9F5FF;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #D4C5F9;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #C4B0F0;
}

QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
}
   </string>
